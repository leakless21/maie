# =============================================================================
# MAIE Jetson Environment Configuration
# =============================================================================
# Copy this file to .env.jetson and customize for your Jetson device.
# When using ENVIRONMENT=jetson, this file will be automatically loaded.
# =============================================================================

# Environment identifier
ENVIRONMENT=jetson

# =============================================================================
# API Settings
# =============================================================================
APP_API__HOST=0.0.0.0
APP_API__PORT=8000
APP_API__SECRET_KEY=your-secret-key-change-this
APP_API__MAX_FILE_SIZE_MB=50

# =============================================================================
# ASR Settings - Whisper
# =============================================================================
# Path to Whisper model (CTranslate2 format)
APP_ASR__WHISPER_MODEL_PATH=data/models/openai-whisper-large
APP_ASR__WHISPER_DEVICE=cuda
APP_ASR__WHISPER_COMPUTE_TYPE=float16
APP_ASR__WHISPER_CPU_FALLBACK=true

# =============================================================================
# ASR Settings - ChunkFormer
# =============================================================================
APP_CHUNKFORMER__CHUNKFORMER_MODEL_PATH=data/models/chunkformer-rnnt-large-vie
APP_CHUNKFORMER__CHUNKFORMER_DEVICE=cuda
APP_CHUNKFORMER__CHUNKFORMER_CPU_FALLBACK=true

# =============================================================================
# VAD Settings
# =============================================================================
APP_VAD__ENABLED=true
APP_VAD__BACKEND=silero
APP_VAD__SILERO_THRESHOLD=0.5
APP_VAD__DEVICE=cuda

# =============================================================================
# Feature Flags - Jetson Specific
# =============================================================================
# Disable heavy features for Jetson
APP_FEATURES__ENABLE_LLM=false
APP_FEATURES__ENABLE_DIARIZATION=false
APP_FEATURES__ENABLE_ENHANCEMENT=false
APP_FEATURES__ENABLE_REDIS_QUEUE=false

# =============================================================================
# Paths
# =============================================================================
APP_PATHS__AUDIO_DIR=data/audio
APP_PATHS__MODELS_DIR=data/models
APP_PATHS__TEMPLATES_DIR=templates

# =============================================================================
# Logging
# =============================================================================
APP_LOGGING__LOG_LEVEL=INFO
APP_LOGGING__LOG_DIR=logs
APP_LOGGING__LOG_ROTATION=50 MB
APP_LOGGING__LOG_RETENTION=3 days

# =============================================================================
# Cleanup
# =============================================================================
APP_CLEANUP__AUDIO_RETENTION_DAYS=1
APP_CLEANUP__LOGS_RETENTION_DAYS=3

# =============================================================================
# Optional: CUDA Settings
# =============================================================================
# Uncomment to limit which GPU is used
# CUDA_VISIBLE_DEVICES=0

# PyTorch memory settings for Jetson (limited RAM)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
