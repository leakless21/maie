{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "tiêu_đề": "Cải thiện văn bản",
  "mô_tả": "Định dạng có cấu trúc cho việc sửa lỗi và cải thiện văn bản tiếng Việt",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "A concise title for the text being enhanced",
      "maxLength": 200
    },
    "văn_bản_gốc": {
      "type": "string",
      "mô_tả": "Văn bản đầu vào gốc được cung cấp, lưu giữ để tham khảo",
      "maxLength": 50000
    },
    "văn_bản_cải_thiện": {
      "type": "string",
      "mô_tả": "Phiên bản văn bản đã được sửa lỗi và cải thiện hoàn toàn với tất cả các chỉnh sửa được áp dụng",
      "maxLength": 50000
    },
    "quality_score": {
      "type": "number",
      "description": "Quality score of the original text from 0.0 (poor) to 1.0 (perfect)",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "language": {
      "type": "string",
      "description": "Primary language code (ISO 639-1, e.g., 'vi', 'en')",
      "pattern": "^[a-z]{2}$",
      "maxLength": 2
    },
    "tags": {
      "type": "array",
      "description": "Category tags for classification (FR-6)",
      "items": {
        "type": "string",
        "maxLength": 50
      },
      "minItems": 1,
      "maxItems": 10
    }
  },
  "required": [
    "title",
    "văn_bản_gốc",
    "văn_bản_cải_thiện",
    "quality_score",
    "language",
    "tags"
  ],
  "additionalProperties": false
}
