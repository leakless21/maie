{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phân tích nội dung có cấu trúc",
  "description": "Định dạng phân tích nội dung theo các phần: mở đầu, báo cáo, thảo luận, kết luận, giao việc",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Tiêu đề ngắn gọn, súc tích của nội dung",
      "x-display-label": "Tiêu đề",
      "maxLength": 200
    },
    "mở_đầu": {
      "type": "object",
      "description": "Phần mở đầu của nội dung",
      "x-display-label": "Mở đầu",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Tóm tắt nội dung phần mở đầu",
          "x-display-label": "Tóm tắt",
          "maxLength": 1000
        },
        "participants": {
          "type": "array",
          "description": "Danh sách người tham gia được giới thiệu",
          "x-display-label": "Người tham gia",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "maxItems": 50
        },
        "context": {
          "type": "string",
          "description": "Bối cảnh hoặc mục đích được đề cập",
          "x-display-label": "Bối cảnh",
          "maxLength": 500
        }
      },
      "required": ["summary"]
    },
    "báo_cáo": {
      "type": "object",
      "description": "Phần báo cáo các thông tin, dữ liệu, cập nhật",
      "x-display-label": "Báo cáo",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Tóm tắt nội dung báo cáo",
          "x-display-label": "Tóm tắt",
          "maxLength": 2000
        },
        "key_points": {
          "type": "array",
          "description": "Các điểm chính trong báo cáo",
          "x-display-label": "Điểm chính",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "maxItems": 20
        },
        "data_mentioned": {
          "type": "array",
          "description": "Các số liệu, dữ liệu được đề cập",
          "x-display-label": "Dữ liệu đề cập",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 30
        }
      },
      "required": ["summary", "key_points"]
    },
    "thảo_luận": {
      "type": "object",
      "description": "Phần thảo luận, trao đổi ý kiến",
      "x-display-label": "Thảo luận",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Tóm tắt nội dung thảo luận",
          "x-display-label": "Tóm tắt",
          "maxLength": 2000
        },
        "topics": {
          "type": "array",
          "description": "Các chủ đề được thảo luận",
          "x-display-label": "Chủ đề",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 15
        },
        "opinions": {
          "type": "array",
          "description": "Các ý kiến, quan điểm chính được đưa ra",
          "x-display-label": "Ý kiến",
          "items": {
            "type": "object",
            "properties": {
              "speaker": {
                "type": "string",
                "description": "Người đưa ra ý kiến",
                "x-display-label": "Người nói",
                "maxLength": 100
              },
              "point": {
                "type": "string",
                "description": "Nội dung ý kiến",
                "x-display-label": "Ý kiến",
                "maxLength": 500
              }
            },
            "required": ["point"]
          },
          "maxItems": 30
        }
      },
      "required": ["summary", "topics"]
    },
    "kết_luận": {
      "type": "object",
      "description": "Phần kết luận, quyết định",
      "x-display-label": "Kết luận",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Tóm tắt kết luận",
          "x-display-label": "Tóm tắt",
          "maxLength": 1500
        },
        "decisions": {
          "type": "array",
          "description": "Các quyết định đã đưa ra",
          "x-display-label": "Quyết định",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "maxItems": 20
        },
        "agreements": {
          "type": "array",
          "description": "Các thỏa thuận, đồng thuận đạt được",
          "x-display-label": "Thỏa thuận",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "maxItems": 20
        }
      },
      "required": ["summary"]
    },
    "giao_việc": {
      "type": "object",
      "description": "Phần giao việc, phân công nhiệm vụ",
      "x-display-label": "Giao việc",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Tóm tắt phần giao việc",
          "x-display-label": "Tóm tắt",
          "maxLength": 1000
        },
        "tasks": {
          "type": "array",
          "description": "Danh sách công việc được giao",
          "x-display-label": "Danh sách công việc",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "description": "Mô tả công việc",
                "x-display-label": "Mô tả",
                "maxLength": 500
              },
              "assignee": {
                "type": "string",
                "description": "Người được giao việc",
                "x-display-label": "Người thực hiện",
                "maxLength": 100
              },
              "deadline": {
                "type": ["string", "null"],
                "description": "Hạn hoàn thành (định dạng YYYY-MM-DD hoặc mô tả)",
                "x-display-label": "Hạn chót",
                "maxLength": 100
              },
              "priority": {
                "type": "string",
                "description": "Mức độ ưu tiên",
                "x-display-label": "Ưu tiên",
                "enum": ["cao", "trung bình", "thấp", "không xác định"]
              }
            },
            "required": ["description"]
          },
          "maxItems": 50
        }
      },
      "required": ["tasks"]
    },
    "tags": {
      "type": "array",
      "description": "Các thẻ phân loại nội dung",
      "x-display-label": "Thẻ",
      "items": {
        "type": "string",
        "maxLength": 50
      },
      "minItems": 1,
      "maxItems": 10
    }
  },
  "required": [
    "title",
    "mở_đầu",
    "báo_cáo",
    "thảo_luận",
    "kết_luận",
    "giao_việc",
    "tags"
  ],
  "additionalProperties": false
}
